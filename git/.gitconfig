[http]
	sslVerify = false

[user]
	email = robert.miller1@bhpbilliton.com
	name = rob miller
[core]
	editor = "vim"
	autocrlf = false
	whitespace = cr-at-eol
	safecrlf = false
	eol = crlf

	
[push]
	default = current
[alias]
	st = status
[pull]
	rebase = false

[color "status"]
        branch = magenta
        untracked = cyan
        unmerged = yellow