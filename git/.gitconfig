[http]
	sslVerify = false
	postBuffer = 100000000

[user]
#	email = funky.style@gmail.com
	name = rob miller
[core]
	editor = "vim"
	autocrlf = input
	#whitespace = cr-at-eol
	safecrlf = false
	eol = lf

	
[push]
	default = current
[alias]
	st = status
	semver = tag --list release/* --sort=-version:refname
        gl = log --simplify-by-decoration --decorate --oneline
[pull]
	rebase = false

[color "status"]
        branch = magenta
        untracked = cyan
        unmerged = yellow
[init]
	defaultBranch = main

[credential]
	helper = store
