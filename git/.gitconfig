[http]
	sslVerify = false

[user]
#	email = funky.style@gmail.com
	name = rob miller
[core]
	editor = "vim"
	autocrlf = input
	#whitespace = cr-at-eol
	safecrlf = false
	eol = lf

	
[push]
	default = current
[alias]
	st = status
[pull]
	rebase = false

[color "status"]
        branch = magenta
        untracked = cyan
        unmerged = yellow
[init]
	defaultBranch = master
