[http]
	sslVerify = false

[user]
	email = robert.miller1@bhpbilliton.com
	name = rob miller
[core]
	editor = "emacs -nw"
	autocrlf = true
	whitespace = cr-at-eol
	
[push]
	default = current
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
