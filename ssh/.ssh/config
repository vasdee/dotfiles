# Name based Azure VMs
Host *.azure.com
 IdentityFile IIoT.pem
 IdentitiesOnly yes

# Azure Devops
Host ssh.dev.azure.com
 IdentityFile ~/.ssh/id_rsa
 IdentitiesOnly yes
 User git
 PubkeyAcceptedKeyTypes=ssh-rsa

Host github.com
 IdentityFile ~/.ssh/id_rsa

Host bitbucket.org
 IdentityFile ~/.ssh/crew-rostering.key
 IdentitiesOnly yes
 User git

Host .compute.amazonaws.com
 IdentityFile ~/.ssh/devhub_rsa
 IdentityFile ~/.ssh/crew-rostering.key
 IdentityFile ~/.ssh/redash.pem
 User ec2-user
 ControlMaster auto
 #ControlPath ~/.ssh/sockets/%r@%h-%p
 ControlPersist 600
 StrictHostKeyChecking=no
 UserKnownHostsFile=/dev/null

Host *
 ServerAliveInterval 200
 #ControlMaster auto
 #ControlPath ~/.ssh/sockets/%r@%h-%p
 #ControlPersist 600
 IdentitiesOnly=yes
