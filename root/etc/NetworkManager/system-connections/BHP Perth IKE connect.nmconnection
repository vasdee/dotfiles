[connection]
id=BHP Perth IKE connect
uuid=f69f4579-60e5-45a1-b033-a4770557d476
type=vpn
autoconnect=false
permissions=user:vasdee:;

[vpn]
authtype=cert
autoconnect-flags=0
cacert=/home/vasdee/Documents/work/vpn/revpn/millrt92.cer.pem
certsigs-flags=0
cookie-flags=2
enable_csd_trojan=no
gateway=vpn.bhp.com/anyconnect
gateway-flags=2
gwcert-flags=2
lasthost-flags=0
pem_passphrase_fsid=no
prevent_invalid_cert=no
protocol=anyconnect
reported_os=win
stoken_source=disabled
usercert=/home/vasdee/Documents/work/vpn/revpn/millrt92.cer.pem
userkey=/home/vasdee/Documents/work/vpn/revpn/millrt92.key.pem
xmlconfig-flags=0
service-type=org.freedesktop.NetworkManager.openconnect

[vpn-secrets]
lasthost=vpn.bhp.com


[ipv4]
dns-search=
method=auto

[ipv6]
addr-gen-mode=stable-privacy
dns-search=
method=auto

[proxy]
