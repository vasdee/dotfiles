GSSAPIAuthentication no

Host 192.168.1.102
 IdentityFile ~/.ssh/id_rsa

Host github.com
 IdentityFile ~/.ssh/id_rsa

Host gitlab.com
  IdentityFile ~/.ssh/bhpgit
  User git
  IdentitiesOnly yes

Host *
 ServerAliveInterval 30
 ControlMaster auto
 ControlPath ~/.ssh/control:%h:%p:%r
 ForwardAgent yes
 Compression yes
 ServerAliveCountMax 30
 TCPKeepAlive yes
 ControlPersist 60
 IdentitiesOnly yes


Include ~/.ssh/config.d/*

